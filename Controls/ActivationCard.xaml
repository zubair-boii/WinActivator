<UserControl x:Class="WinActivator.Controls.ActivationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinActivator.Controls"
             mc:Ignorable="d" 
             x:Name="Root"
             
             >
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HCHoverCard" TargetType="Border">
            <Setter Property="Background" Value="#1e1e1e" />
            <Setter Property="BorderBrush" Value="#2d2d2d" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252525" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource HCHoverCard}"
            Margin="0 4"
            Padding="16 12"
            Cursor="Hand"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid d:DataContext="{d:DesignInstance Type=UserControl}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{Binding Icon, ElementName=Root}" 
                   Width="36" 
                   Height="36" 
                   Stretch="Uniform" 
                   VerticalAlignment="Center"
                   Margin="4 0 16 0"/>

            <StackPanel Grid.Column="1" 
                        VerticalAlignment="Center" 
                        Margin="0 0 16 0">
                <TextBlock Text="{Binding CardTitle, ElementName=Root}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0 0 0 3"/>
                <TextBlock Text="{Binding CardDescription, ElementName=Root}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           LineHeight="16"/>
            </StackPanel>

            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">

                <RadioButton Content="{Binding Option1Text, ElementName=Root}"
                             IsChecked="{Binding IsOption1Checked, ElementName=Root}"
                             
                             VerticalAlignment="Center"
                             Margin="6 0"
                             Style="{StaticResource RadioButtonBaseStyle}" 
                             Foreground="{DynamicResource PrimaryTextBrush}"/>

                <RadioButton Content="{Binding Option2Text, ElementName=Root}"
                             IsChecked="{Binding IsOption2Checked, ElementName=Root}"
                             Visibility="{Binding HasTwoOptions, ElementName=Root, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center"
                             
                             Margin="6 0"
                             Style="{StaticResource RadioButtonBaseStyle}" 
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
