<Window x:Class="WinActivator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinActivator"
        Width="1000"
        Height="780"
        MinWidth="600"
        MinHeight="500"
        Background="#1c1c1c">

    <Grid Margin="30">

        <!-- 3 rows: header (Auto), content (*), footer (Auto) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER (explicitly in row 0) -->
        <Grid Grid.Row="0"
              Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left side (title + subtitle) -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top">
                <TextBlock Text="WinActivator"
                           Style="{StaticResource TitleText}" />

                <TextBlock Text="Manage your system license and activation methods"
                           Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <!-- Right side -->
            <Border Style="{StaticResource CardStyle}"
                    Grid.Column="1"
                    Padding="20 10">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               FontSize="14"
                               Text="Operating System: " />
                    <TextBlock Style="{StaticResource SubtitleText}"
                               Name="OSIdentifierTxt"
                               
                               />

                    <TextBlock Style="{StaticResource SubtitleText}"
                               Foreground="LightGreen"
                               Margin="0 10 0 0"
                               FontWeight="Bold"
                               Name="ActivationStatusTxt"
                                />

                </StackPanel>
            </Border>

        </Grid>

        <!-- MAIN (row 1) -->
        <!-- ScrollViewer wraps content and allows vertical scroll when necessary -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0 10 0 0">

            <!-- Constrain content width so WrapPanel can calculate wrapping reliably -->
            <StackPanel HorizontalAlignment="Center"
                        Margin="0 10">

                <TextBlock FontSize="17"
                           FontWeight="Bold"
                           Foreground="#a1a1a1"
                           Text="Choose Activation Method:"
                           Margin="0 0 0 12" />

                <!-- WrapPanel with ItemWidth/ItemHeight so items wrap predictably -->
                <WrapPanel Margin="0 0 0 40"
                           HorizontalAlignment="Center"
                           Orientation="Horizontal">

                    <!-- Card 1 -->
                    <Border Style="{StaticResource HoverCard}"
                            Margin="8"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown"
                            >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Side Content -->
                            <StackPanel Grid.Column="0"
                                        Margin="6">
                                <Image Source="Assets/Icons/tsforge_icon.png" Width="50" Height="50" Stretch="UniformToFill" HorizontalAlignment="Left"/>

                                <TextBlock Text="TSForge Activation"
                                           Style="{StaticResource CardTitle}" />

                                <TextBlock Text="Permanent hardware based digital license."
                                           Style="{StaticResource CardDescription}"
                                           Margin="0 6 0 0" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Right Side Radio -->
                                <RadioButton Grid.Column="1"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Right"
                                             Style="{StaticResource ModernRadioButton}"
                                             Margin="6"
                                             Name="tsforgeRadioBtn"
                                             GroupName="ActivationMethod" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border Style="{StaticResource HoverCard}"
                            Margin="8"
                            MouseLeftButtonDown="Ohook_MouseLeftButtonDown"
                            >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Side Content -->
                            <StackPanel Grid.Column="0"
                                        Margin="6">
                                <Image Source="Assets/Icons/ohook_icon.png" Width="50" Height="50" Stretch="UniformToFill" HorizontalAlignment="Left"/>

                                <TextBlock Text="Ohook Activation"
                                           Style="{StaticResource CardTitle}" />

                                <TextBlock Text="Permanent hardware based digital license."
                                           Style="{StaticResource CardDescription}"
                                           Margin="0 6 0 0" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Right Side Radio -->
                                <RadioButton Grid.Column="1"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Right"
                                             Style="{StaticResource ModernRadioButton}"
                                             Margin="6"
                                             Name="OhookRadioBtn"
                                             GroupName="ActivationMethod" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border Style="{StaticResource HoverCard}"
                            MouseLeftButtonDown="hwid_MouseLeftButtonDown_1"
                            Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Side Content -->
                            <StackPanel Grid.Column="0"
                                        Margin="6">
                                <Image Source="Assets/Icons/hwid_icon.png"  Width="50" Height="50" Stretch="UniformToFill" HorizontalAlignment="Left"/>


                                <TextBlock Text="HWID Activation"
                                           Style="{StaticResource CardTitle}" />

                                <TextBlock Text="Permanent hardware based digital license."
                                           Style="{StaticResource CardDescription}"
                                           Margin="0 6 0 0" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Right Side Radio -->
                                <RadioButton Grid.Column="1"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Right"
                                             Style="{StaticResource ModernRadioButton}"
                                             Margin="6"
                                             Name="hwidRadioBtn"
                                             GroupName="ActivationMethod" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    

                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER (explicitly Grid.Row=2) -->
        <Grid Grid.Row="2"
              Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Footer left (optional status) -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <Border Style="{StaticResource ContactCard}"
                        HorizontalAlignment="Left"
                        Height="60"
                        Padding="20 10">
                    <StackPanel VerticalAlignment="Center"
                                Margin="0 0 8 0">
                        <TextBlock FontSize="14"
                                   Foreground="#AAAAAA"
                                   Text="Zubair Computer Lab" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 5">
                            <Image Source="Assets/Icons/whatsapp_icon.png"  Width="20" Height="20" Stretch="UniformToFill" />

                            <TextBlock FontSize="13"
                                       Foreground="#AAAAAA"
                                       Text="0336-9141706"
                                       Margin="10 0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock FontSize="13"
                           Foreground="#AAAAAA"
                           Margin="20 5"
                           Text="Version 2.0.0" />
            </StackPanel>

            <!-- Footer right: button -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource CustomButton}"
                        Content="Activate Product"
                        Width="220"
                        Click="ActivateButton_Click"
                        Name="ActivateButton"
                        Margin="0 0 0 0" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>