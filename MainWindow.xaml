<Window x:Class="WinActivator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol" 
        xmlns:controls="clr-namespace:WinActivator.Controls"
        Title="WinActivator Professional Dashboard"
        Width="1000" Height="650"
        MinWidth="900" MinHeight="650"
        Background="#141414"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!--Column definitions-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side bar -->
            <Border Background="#1c1c1c" Grid.Column="0" BorderBrush="#2d2d2d" BorderThickness="0 0 1 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24 30 24 20">
                        <TextBlock Text="WinActivator" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Management Suite v2.2.0" Foreground="#666666" FontSize="11" Margin="0 4 0 0"/>
                    </StackPanel>

                    <hc:SideMenu Grid.Row="1" x:Name="SideNavigationMenu" SelectionChanged="SideMenu_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <hc:SideMenuItem Header="Dashboard" IsSelected="True">
                            <hc:SideMenuItem.Icon>
                                <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="#888888" Width="16" Height="16" Stretch="Uniform"/>
                            </hc:SideMenuItem.Icon>
                        </hc:SideMenuItem>
                        <hc:SideMenuItem Header="Settings">
                            <hc:SideMenuItem.Icon>
                                <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87c-0.12,0.21-0.07,0.47,0.12,0.61l2.03,1.58C4.84,11.36,4.81,11.68,4.81,12c0,0.32,0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.21,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#888888" Width="16" Height="16" Stretch="Uniform"/>
                            </hc:SideMenuItem.Icon>
                        </hc:SideMenuItem>
                    </hc:SideMenu>
                </Grid>
            </Border>

            <!-- Main Screen -->
            <Grid Grid.Column="1" Margin="30 24">
                <TabControl x:Name="MainTabContainer" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem Header="Dashboard">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1c1c1c" CornerRadius="6" Padding="20 16" Margin="0 0 0 20" BorderBrush="#252525" BorderThickness="1">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OPERATING SYSTEM PROFILE" Foreground="#555555" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="OSIdentifierTxt" Text="Detecting Environment Parameters..." Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0 4 0 0"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#26ffffff" CornerRadius="4" Padding="10 6">
                                        <TextBlock x:Name="ActivationStatusTxt" Text="STATUS: CHECKING" Foreground="#A1A1A1" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0 0 10 0">

                                    <TextBlock Text="SYSTEM LICENSING OPERATIONS" Foreground="#107C41" FontSize="11" FontWeight="Bold" Margin="0 10 0 8"/>
                                    <Border Background="#1a1a1a" CornerRadius="6" BorderBrush="#252525" BorderThickness="1" Padding="8" Margin="0 0 0 24">
                                        <StackPanel>
                                            <controls:ActivationCard x:Name="HwidCard"
                                                             Icon="Assets/Icons/hwid_icon.png"
                                                             CardTitle="HWID (Hardware ID Verification)"
                                                             CardDescription="Establishes a lifetime permanent hardware digital entitlement license directly with Microsoft servers. Optimized for Windows 10 &amp; 11 installations."
                                                             Option1Text="Activate Windows 10/11"/>

                                            <Border BorderBrush="#252525" BorderThickness="0 1 0 0" Margin="10 4"/>

                                            <controls:ActivationCard x:Name="OhookCard"
                                                             Icon="Assets/Icons/ohook_icon.png"
                                                             CardTitle="Ohook Engine Deployment"
                                                             CardDescription="Injects localized runtimes to validate Microsoft Office suites seamlessly without applying aggressive disk-level file patching methods."
                                                             Option1Text="Inject Office Integration"/>

                                            <Border BorderBrush="#252525" BorderThickness="0 1 0 0" Margin="10 4"/>

                                            <controls:ActivationCard x:Name="TsForgeCard"
                                                             Icon="Assets/Icons/tsforge_icon.png"
                                                             CardTitle="TSForge Legacy Engine"
                                                             CardDescription="Specialized emulator alternative for handling backward-compatibility layers, vintage OS builds, or complex business environments."
                                                             Option1Text="Windows License"
                                                             Option2Text="Office License"
                                                             HasTwoOptions="True"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="APPLICATION EXTENSIONS &amp; TOOLS" Foreground="#007ACC" FontSize="11" FontWeight="Bold"  Margin="0 5 0 8"/>
                                    <Border Background="#1a1a1a" CornerRadius="6" BorderBrush="#252525" BorderThickness="1" Padding="8" Margin="0 0 0 15">
                                        <StackPanel>
                                            <controls:ActivationCard x:Name="IdmCard"
                                                             Icon="Assets/Icons/idm_icon.png"
                                                             CardTitle="Internet Download Manager Extension"
                                                             CardDescription="Configures execution strings and local server mappings for active IDM builds. May require verification of host download directories."
                                                             Option1Text="Configure IDM Hook"/>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="#252525" BorderThickness="0 1 0 0" Padding="0 10 0 0">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Technical Laboratory Support:" Foreground="#555555" FontSize="11"/>
                                        <TextBlock Text="Zubair Computer Lab - WhatsApp: 0336-9141706" Foreground="#999999" FontSize="12" Margin="0 2 0 0"/>
                                    </StackPanel>
                                    <Button x:Name="ActivateButton" 
                                    Content="Execute Target Automation" 
                                    HorizontalAlignment="Right" 
                                    Width="250" Height="42" 
                                     />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Settings">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="System Parameters Configuration" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Global orchestration preferences can be customized within this view." Foreground="#666666" Margin="0 4 0 0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <!-- Status Bar -->
        <StatusBar Grid.Row="1" Background="#181818" BorderBrush="#2d2d2d" BorderThickness="0 1 0 0" Padding="15 4">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusExecutionDot" Width="8" Height="8" Fill="#00FF00" VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <TextBlock x:Name="StatusBarMessageTxt" Text="System Status Ready" Foreground="#888888" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>