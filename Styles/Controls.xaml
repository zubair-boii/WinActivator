<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card -->

    <Style x:Key="CardStyle"
           TargetType="Border">

        <Setter Property="Background"
                Value="#1E1E1E" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="BorderBrush"
                Value="#333333" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="20" />
        <Setter Property="Margin"
                Value="10" />

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="0"
                                  Opacity="0.35" />
            </Setter.Value>
        </Setter>

    </Style>
    
    
    <!--Contact Card-->
    <Style x:Key="ContactCard"
           TargetType="Border">

        <Setter Property="Background"
                Value="#222222" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="Padding"
                Value="20 10" />
    </Style>


    <!-- Card Hover -->

    <Style x:Key="HoverCard"
           TargetType="Border"
           BasedOn="{StaticResource CardStyle}">

        <Setter Property="Cursor"
                Value="Hand" />

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">
                <!--<Setter Property="Background"
                        Value="#19252f" />-->
                <Setter Property="BorderBrush"
                        Value="#3EA6FF" />
                <Setter Property="BorderThickness"
                        Value="2" />

            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- Title -->

    <Style x:Key="TitleText"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="26" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="White" />

    </Style>


    <!-- Subtitle -->

    <Style x:Key="SubtitleText"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="#AAAAAA" />

    </Style>


    <!-- Card Title -->

    <Style x:Key="CardTitle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="White" />

    </Style>


    <!-- Card Description -->

    <Style x:Key="CardDescription"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="#BBBBBB" />
        <Setter Property="TextWrapping"
                Value="Wrap" />

    </Style>

    
    <!--Custom Button-->
    <Style x:Key="CustomButton"
           TargetType="Button">

        <Setter Property="Foreground"
                Value="#2D2D2D" />
        <Setter Property="Background"
                Value="#3EA6FF" />
        <Setter Property="BorderBrush"
                Value="#3EA6FF" />
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="Padding"
                Value="10 15" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#3EA6FF" />

                            <Setter Property="Foreground"
                                    Value="#2D2D2D" />

                        </Trigger>

                        <!-- Click -->

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#1F6ED4" />

                        </Trigger>

                        <!-- Disabled -->

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.5" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>
    
    
    <!--Modern Custom Radio Button-->
    <Style x:Key="ModernRadioButton"
           TargetType="RadioButton">

        <Setter Property="Width"
                Value="22" />
        <Setter Property="Height"
                Value="22" />
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="RadioButton">

                    <Grid Width="22"
                          Height="22">

                        <!-- Outer Circle -->
                        <Ellipse x:Name="OuterCircle"
                                 Stroke="#888"
                                 StrokeThickness="2"
                                 Fill="Transparent" />

                        <!-- Inner Dot -->
                        <Ellipse x:Name="InnerCircle"
                                 Width="10"
                                 Height="10"
                                 Fill="#4da3ff"
                                 Opacity="0" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Checked -->
                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter TargetName="OuterCircle"
                                    Property="Stroke"
                                    Value="#4da3ff" />

                            <Setter TargetName="InnerCircle"
                                    Property="Opacity"
                                    Value="1" />

                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="OuterCircle"
                                    Property="Stroke"
                                    Value="#4da3ff" />

                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="OuterCircle"
                                    Property="Opacity"
                                    Value="0.4" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>